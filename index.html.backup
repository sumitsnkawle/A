                    'exec-c4-t': dict.execC4T, 'exec-c4-d': dict.execC4D,

                    'strat-title': dict.stratTitle,
                    'strat-c1-t': dict.stratC1T, 'strat-c1-l1': dict.stratC1L1, 'strat-c1-l2': dict.stratC1L2, 'strat-c1-l3': dict.stratC1L3,
                    'strat-c2-t': dict.stratC2T, 'strat-c2-l1': dict.stratC2L1, 'strat-c2-l2': dict.stratC2L2, 'strat-c2-l3': dict.stratC2L3,
                    'strat-c3-t': dict.stratC3T, 'strat-c3-l1': dict.stratC3L1, 'strat-c3-l2': dict.stratC3L2, 'strat-c3-l3': dict.stratC3L3,
                    'strat-c4-t': dict.stratC4T, 'strat-c4-l1': dict.stratC4L1, 'strat-c4-l2': dict.stratC4L2, 'strat-c4-l3': dict.stratC4L3,

                    'how-title-main': dict.howTitleMain,
                    'how-desc-main': dict.howDescMain,
                    'wf-p1': dict.wfP1, 'wf-s1-t': dict.wfS1T, 'wf-s1-d': dict.wfS1D,
                    'wf-p2': dict.wfP2, 'wf-s2-t': dict.wfS2T, 'wf-s2-d': dict.wfS2D,
                    'wf-p3': dict.wfP3, 'wf-s3-t': dict.wfS3T, 'wf-s3-d': dict.wfS3D,
                    'wf-p4': dict.wfP4, 'wf-s4-t': dict.wfS4T, 'wf-s4-d': dict.wfS4D,
                    'wf-p5': dict.wfP5, 'wf-s5-t': dict.wfS5T, 'wf-s5-d': dict.wfS5D,
                    'wf-p6': dict.wfP6, 'wf-s6-t': dict.wfS6T, 'wf-s6-d': dict.wfS6D,
                    'wf-p7': dict.wfP7, 'wf-s7-t': dict.wfS7T, 'wf-s7-d': dict.wfS7D,

                    'risk-score-label': dict.riskScoreLabel,
                    'impact-tag': dict.impactTag,
                    'impact-title': dict.impactTitle,
                    'impact-desc': dict.impactDesc,
                    'imp-feature1-title': dict.impFeature1Title, 'imp-feature1-desc': dict.impFeature1Desc,
                    'imp-feature2-title': dict.impFeature2Title, 'imp-feature2-desc': dict.impFeature2Desc,
                    'imp-feature3-title': dict.impFeature3Title, 'imp-feature3-desc': dict.impFeature3Desc,
                    'imp-feature4-title': dict.impFeature4Title, 'imp-feature4-desc': dict.impFeature4Desc,

                    'cap-main-title': dict.capMainTitle,
                    'cap-main-desc': dict.capMainDesc,
                    'cap-c1-t': dict.capC1T, 'cap-c1-d': dict.capC1D,
                    'cap-c2-t': dict.capC2T, 'cap-c2-d': dict.capC2D,
                    'cap-c3-t': dict.capC3T, 'cap-c3-d': dict.capC3D,
                    'cap-c4-t': dict.capC4T, 'cap-c4-d': dict.capC4D,
                    'cap-c5-t': dict.capC5T, 'cap-c5-d': dict.capC5D,
                    'cap-c6-t': dict.capC6T, 'cap-c6-d': dict.capC6D,
                    'cap-c7-t': dict.capC7T, 'cap-c7-d': dict.capC7D,
                    'cap-c8-t': dict.capC8T, 'cap-c8-d': dict.capC8D,

                    'cta-title': dict.ctaTitle,
                    'cta-desc': dict.ctaDesc,
                    'cta-btn-primary': dict.ctaBtnPrimary,
                    'cta-btn-secondary': dict.ctaBtnSecondary,
                    'cta-router-prefix': dict.ctaRouterPrefix,
                    'footer-title': dict.footerTitle,
                    'footer-desc': dict.footerDesc,
                    'footer-copyright': dict.footerCopyright
                };

                Object.keys(map).forEach(id => {
                    const el = document.getElementById(id);
                    if (el && map[id]) el.textContent = map[id];
                });
            }

            if (langSelector) {
                langSelector.addEventListener('change', (e) => {
                    applyTranslation(e.target.value);
                    localStorage.setItem('regulus-selected-lang', e.target.value);
                });

                const savedLang = localStorage.getItem('regulus-selected-lang');
                if (savedLang && translations[savedLang]) {
                    langSelector.value = savedLang;
                    applyTranslation(savedLang);
                }
            }
        })();

        // GSAP & ScrollTrigger Animations & Interactive Demo Initialization
        window.addEventListener("load", function () {
            if (typeof gsap !== "undefined" && typeof ScrollTrigger !== "undefined") {
                gsap.registerPlugin(ScrollTrigger);

                // Enterprise Business Value Section Animations
                const riskScoreObj = { val: 100 };
                const riskScoreEl = document.getElementById("impact-risk-score");
                const statusTagEl = document.getElementById("impact-status-tag");

                if (riskScoreEl && statusTagEl) {
                    gsap.to(riskScoreObj, {
                        val: 12,
                        duration: 2.2,
                        ease: "power2.out",
                        scrollTrigger: {
                            trigger: "#business-impact-section",
                            start: "top 85%",
                            toggleActions: "play none none reverse"
                        },
                        onUpdate: function () {
                            riskScoreEl.textContent = Math.round(riskScoreObj.val) + "%";
                        },
                        onComplete: function () {
                            statusTagEl.textContent = "● Risk Mitigated (88% Reduction)";
                            statusTagEl.className = "text-[10px] sm:text-xs text-emerald-400 font-medium px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 mt-2 transition-all duration-300";
                        }
                    });
                }

                gsap.from(".impact-feature-item", {
                    y: 25,
                    opacity: 0,
                    duration: 0.6,
                    stagger: 0.15,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#impact-features-grid",
                        start: "top 85%",
                        toggleActions: "play none none reverse"
                    }
                });

                // Animate the Workflow Timeline Vertical Progress Bar
                gsap.to("#gsap-workflow-progress", {
                    height: "100%",
                    ease: "none",
                    scrollTrigger: {
                        trigger: "#workflow-steps-container",
                        start: "top 70%",
                        end: "bottom 80%",
                        scrub: true
                    }
                });

                // Fade & Slide in Step Cards on Scroll
                gsap.utils.toArray(".workflow-step-card").forEach((card) => {
                    gsap.from(card, {
                        y: 30,
                        opacity: 0,
                        duration: 0.6,
                        ease: "power2.out",
                        scrollTrigger: {
                            trigger: card,
                            start: "top 85%",
                            toggleActions: "play none none reverse"
                        }
                    });
                });

                // Entrance animations for Capabilities Grid
                gsap.from("#capabilities-grid > div", {
                    y: 20,
                    opacity: 0,
                    duration: 0.5,
                    stagger: 0.05,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#capabilities",
                        start: "top 95%",
                        toggleActions: "play none none none"
                    }
                });

                setTimeout(() => {
                    ScrollTrigger.refresh();
                }, 100);
            }

            // Fallback: Ensure grid elements are visible if animation script is bypassed
            document.querySelectorAll('#capabilities-grid > div').forEach(el => {
                el.style.opacity = '1';
                el.style.visibility = 'visible';
            });

            // Interactive Pipeline Demo Button Script
            const replayBtn = document.getElementById('replay-pipeline-btn');
            const scanBar = document.getElementById('scan-bar');
            const scanText = document.getElementById('pipeline-scan-text');
            const outputBox = document.getElementById('pipeline-output-box');
            const outputBadge = document.getElementById('output-stage-badge');
            const outputStatus = document.getElementById('output-status');
            const outputText = document.getElementById('pipeline-output-text');

            function runPipelineDemo() {
                if (!scanBar || !scanText || !outputBox || !outputBadge || !outputStatus || !outputText) return;

                // Reset state
                outputBox.classList.add('opacity-40');
                outputBox.classList.remove('border-emerald-500/40');
                outputBadge.classList.remove('bg-emerald-500/10', 'text-emerald-400');
                outputBadge.classList.add('text-slate-500');
                outputStatus.className = 'text-[11px] font-mono text-amber-400';
                outputStatus.textContent = '⚡ Executing Checks...';
                scanText.textContent = 'Scanning Regulatory Frameworks...';
                
                // GSAP Scan Animation
                if (typeof gsap !== "undefined") {
                    gsap.fromTo(scanBar, 
                        { top: '0%', opacity: 1 }, 
                        { top: '100%', opacity: 1, duration: 1.5, repeat: 1, yoyo: true, ease: "power1.inOut", onComplete: () => {
                            scanText.textContent = 'Validation Complete';
                            scanBar.style.opacity = '0';
                            
                            // Reveal Output
                            outputBox.classList.remove('opacity-40');
                            outputBox.classList.add('border-emerald-500/40');
                            outputBadge.classList.add('bg-emerald-500/10', 'text-emerald-400');
                            outputStatus.className = 'text-[11px] font-mono text-emerald-400';
                            outputStatus.textContent = '● Remediated';
                            outputText.className = 'text-xs sm:text-sm text-emerald-300 font-mono';
                            outputText.textContent = 'Add mandatory advisory statement: "Food supplements must not be used as a substitute for a varied and balanced diet and a healthy lifestyle." [UK FSA Guidelines]';
                        }}
                    );
                }
            }

            if (replayBtn) {
                replayBtn.addEventListener('click', runPipelineDemo);
            }
        });
    </script>
</body>
</html>