    <!-- Interactive Component Script Orchestration Layers -->
    <script>
        // Responsive Mobile Menu Handler
        (function() {
            const menuToggle = document.getElementById('mobile-menu-toggle');
            const mobileMenu = document.getElementById('mobile-menu');
            const menuIcon = document.getElementById('menu-icon');
            const navLinks = document.querySelectorAll('.mobile-nav-link');

            function toggleMenu() {
                const isHidden = mobileMenu.classList.contains('hidden');
                if (isHidden) {
                    mobileMenu.classList.remove('hidden');
                    menuIcon.setAttribute('d', 'M6 18L18 6M6 6l12 12');
                } else {
                    mobileMenu.classList.add('hidden');
                    menuIcon.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
                }
            }

            if (menuToggle) {
                menuToggle.addEventListener('click', toggleMenu);
            }
            navLinks.forEach(link => link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
                menuIcon.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
            }));
        })();

        // Theme Selection Management Configuration
        (function() {
            const themeSelector = document.getElementById('theme-selector');
            const body = document.body;
            const themes = ['theme-charcoal', 'theme-slate', 'theme-void'];

            function changeTheme(selectedTheme) {
                themes.forEach(t => body.classList.remove(t));
                body.classList.add(selectedTheme);
                localStorage.setItem('regulus-selected-theme', selectedTheme);
            }

            if (themeSelector) {
                themeSelector.addEventListener('change', (e) => {
                    changeTheme(e.target.value);
                });

                const savedTheme = localStorage.getItem('regulus-selected-theme');
                if (savedTheme && themes.includes(savedTheme)) {
                    themeSelector.value = savedTheme;
                    changeTheme(savedTheme);
                }
            }
        })();

